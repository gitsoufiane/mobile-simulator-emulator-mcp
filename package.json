{
  "name": "local-mobile-mcp-server",
  "version": "0.5.0",
  "description": "Local MCP server for controlling iOS Simulators and Android Emulators",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ios-simulator",
    "android-emulator",
    "mobile-testing",
    "webdriveragent",
    "adb",
    "simctl"
  ],
  "homepage": "https://github.com/gitsoufiane/mobile-simulator-emulator-mcp#readme",
  "bugs": "https://github.com/gitsoufiane/mobile-simulator-emulator-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitsoufiane/mobile-simulator-emulator-mcp.git"
  },
  "type": "module",
  "bin": {
    "mobile-mcp-server": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/src/index.js",
    "start": "node dist/src/index.js",
    "test": "node --test dist/test/*.test.js",
    "check": "npm run build && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "live": "node dist/test/live-smoke.js",
    "live:deep": "node dist/test/live-manipulation.js",
    "live:tools": "node dist/test/live-tools.js",
    "live:extended": "node dist/test/live-extended.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "appium-webdriveragent": "16.12.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
